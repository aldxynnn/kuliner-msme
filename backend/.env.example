# Salin file ini menjadi backend/.env (JANGAN pernah commit backend/.env ke Git).
# Untuk produksi (SnapDeploy), atur seluruh variabel ini melalui Environment Variables dashboard.

DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?schema=public"
DIRECT_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?schema=public"

PORT=3000
JWT_SECRET=CHANGE_ME_WITH_STRONG_RANDOM_SECRET
FRONTEND_URL=https://aroma-ayam-goreng-lengkuas.vercel.app

