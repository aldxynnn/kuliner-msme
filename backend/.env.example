# Salin file ini menjadi backend/.env sebelum menjalankan backend secara lokal (jangan commit backend/.env).

# Opsi 1: PostgreSQL lokal native (default port 5432)
DATABASE_URL="postgresql://kuliner_user:kuliner_pass@localhost:5432/kuliner_db?schema=public"
DIRECT_URL="postgresql://kuliner_user:kuliner_pass@localhost:5432/kuliner_db?schema=public"

# Opsi 2: Jika menggunakan container PostgreSQL dari docker-compose.yml (port 5433)
# DATABASE_URL="postgresql://kuliner_user:kuliner_pass@localhost:5433/kuliner_db?schema=public"
# DIRECT_URL="postgresql://kuliner_user:kuliner_pass@localhost:5433/kuliner_db?schema=public"

# Konfigurasi Server Backend
PORT=3000
JWT_SECRET=kuliner_msme_jwt_secret_dev_key_2025
FRONTEND_URL=http://localhost:5173

# Opsional: Cloudinary untuk upload foto cloud produksi (kosongkan untuk simpan lokal di backend/uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
