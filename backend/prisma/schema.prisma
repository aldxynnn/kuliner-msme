generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

enum PaymentMethod {
  QRIS
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum OrderStatus {
  MENUNGGU_PEMBAYARAN
  MENUNGGU_DIPROSES
  DIPROSES
  SIAP_DISAJIKAN
  SELESAI
  DIBATALKAN
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  role               Role      @default(CASHIER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  paymentsConfirmed  Payment[]
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String        @id @default(uuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int
  image       String?
  isAvailable Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  orderDetails OrderDetail[]
}

model Table {
  id          String   @id @default(uuid())
  tableNumber String   @unique
  qrCode      String
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  customerName  String?
  orderType     OrderType
  tableId       String?
  table         Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(MENUNGGU_PEMBAYARAN)
  subtotal      Int
  total         Int
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orderDetails  OrderDetail[]
  payments      Payment[]
}

model OrderDetail {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  price       Int
  quantity    Int
  notes       String?
  subtotal    Int
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount            Int
  paymentMethod     PaymentMethod
  status            PaymentStatus
  confirmedAt       DateTime?
  confirmedByUserId String?
  confirmedByUser   User?         @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Int
  category    String
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
